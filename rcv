#!/usr/bin/env python3
"""
Roll Call Vote (RCV) Tracker CLI

Usage: ./rcv <last_name> <state> <district> <congress_number>

Example: ./rcv Thompson CA 04 118
"""

import sys
import os
import time
from pathlib import Path

# Add the rcv_votes package to the Python path
sys.path.insert(0, str(Path(__file__).parent))

# Load environment variables from .env file
from dotenv import load_dotenv
load_dotenv()

from rcv_votes.container import ApplicationContainer
from rcv_votes.models import MemberSearchCriteria
from rcv_votes.exceptions import RCVError, ConfigurationError, ValidationError
from rcv_votes.logging_config import log_operation_start, log_operation_success, log_operation_error


def print_usage():
    """Print usage information."""
    print("Usage: ./rcv <last_name> <state> <district> <congress_number>")
    print("")
    print("Arguments:")
    print("  last_name        Last name of the congress member")
    print("  state            Two-letter state abbreviation (e.g., CA, NY, TX)")
    print("  district         House district number (e.g., 04 or 4)")
    print("  congress_number  Congress number to search (e.g., 118). One congress per run.")
    print("")
    print("Example:")
    print("  ./rcv Thompson CA 04 118")
    print("")
    print("Environment:")
    print("  CONGRESS_API_KEY  Required. Get from https://api.congress.gov/sign-up/")
    print("  JSON_LOGS         Optional. Set to 'true' for JSON log format")
    print("  RCV_REFRESH       Optional. Set to 'true' to ignore cached roll calls and refetch")


def print_problems(result) -> None:
    """Print any roll calls that failed and any early stop, so incomplete data is obvious."""
    if result.aborted_reason:
        print(f"[WARNING] {result.aborted_reason}")
    
    if result.failures:
        print(f"[WARNING] {len(result.failures)} roll calls could not be collected and are missing from the output:")
        for failure in result.failures[:20]:
            print(f"  Congress {failure.congress}, session {failure.session}, "
                  f"roll call {failure.roll_call_number}: {failure.reason}")
        if len(result.failures) > 20:
            print(f"  ... and {len(result.failures) - 20} more (see logs)")
        print("Re-run the same command to retry them; completed roll calls are cached.")


def parse_arguments(args: list) -> MemberSearchCriteria:
    """
    Parse command line arguments.
    
    Args:
        args: Command line arguments (excluding script name)
        
    Returns:
        Parsed search criteria
        
    Raises:
        ValidationError: If arguments are invalid
    """
    if len(args) != 4:
        raise ValidationError(
            "Expected exactly 4 arguments: <last_name> <state> <district> <congress_number> "
            "(one congress per run)"
        )
    
    last_name = args[0]
    state = args[1]
    
    # Parse district (leading zeros allowed, e.g., "04")
    try:
        district = int(args[2])
    except ValueError:
        raise ValidationError(f"Invalid district (must be integer): {args[2]}")
    
    # Parse congress number
    try:
        congress = int(args[3])
    except ValueError:
        raise ValidationError(f"Invalid congress number (must be integer): {args[3]}")
    
    return MemberSearchCriteria(
        last_name=last_name,
        state=state,
        district=district,
        congress=congress
    )


def main():
    """Main CLI entry point."""
    # Check for help flags
    if len(sys.argv) < 2 or sys.argv[1] in ['-h', '--help', 'help']:
        print_usage()
        sys.exit(0)
    
    # Parse command line arguments
    try:
        search_criteria = parse_arguments(sys.argv[1:])
    except ValidationError as e:
        print(f"[ERROR] {e}")
        print("")
        print_usage()
        sys.exit(1)
    
    # Check for JSON logs environment variable
    json_logs = os.getenv('JSON_LOGS', '').lower() == 'true'
    verbose = os.getenv('VERBOSE', '').lower() == 'true'
    refresh_cache = os.getenv('RCV_REFRESH', '').lower() == 'true'
    
    # Initialize application container
    try:
        with ApplicationContainer(verbose=verbose, json_logs=json_logs,
                              refresh_cache=refresh_cache) as container:
            # Validate configuration before proceeding
            container.validate_configuration()
            
            logger = container.logger
            correlation_id = container.correlation_id
            
            # Log operation start
            operation = f"rcv_collection_{search_criteria.last_name}_{search_criteria.state}"
            log_operation_start(logger, operation, correlation_id,
                              member=search_criteria.last_name,
                              state=search_criteria.state,
                              district=search_criteria.district,
                              congress=search_criteria.congress)
            
            # Print user-friendly start message
            print(f"Collecting all roll call votes, with the vote of {search_criteria.last_name} ({search_criteria.state}-{search_criteria.district}) on each")
            print(f"Congress: {search_criteria.congress}")
            print("")
            
            start_time = time.time()
            
            try:
                # Collect every roll call vote in the requested congress, with the
                # member's vote (including missed votes) on each
                result = container.vote_collector.collect_member_votes(
                    search_criteria, correlation_id
                )
                vote_records = result.records
                
                if not vote_records:
                    print(f"[WARNING] No votes found for {search_criteria.last_name} ({search_criteria.state}-{search_criteria.district})")
                    print("This could mean:")
                    print("- The member name, state, or district is incorrect")
                    print("- The member did not serve in the specified congress sessions")
                    print("- No roll call votes were found for the specified congress sessions")
                    print_problems(result)
                    sys.exit(0)
                
                # Export to CSV (flagged as partial if anything was missed)
                csv_file_path = container.csv_exporter.export_votes(
                    vote_records, search_criteria.last_name, search_criteria.congress,
                    partial=not result.complete
                )
                
                # Success message
                duration = time.time() - start_time
                missed = sum(1 for r in vote_records if r.missed_vote)
                status = "SUCCESS" if result.complete else "WARNING"
                print(f"[{status}] Collected {len(vote_records)} roll calls in {duration:.1f} seconds")
                print(f"Source: {result.cache_hits} from cache, {result.api_calls} API requests")
                print(f"Missed votes (Not Voting): {missed}")
                print_problems(result)
                print(f"Results saved to: {csv_file_path}")
                
                # Log successful completion
                log_operation_success(logger, operation, correlation_id, duration,
                                    total_votes=len(vote_records),
                                    output_file=csv_file_path)
                
            except RCVError as e:
                duration = time.time() - start_time
                print(f"[ERROR] {e}")
                
                # Log the error
                log_operation_error(logger, operation, correlation_id, e,
                                  duration=duration)
                sys.exit(1)
            
            except Exception as e:
                duration = time.time() - start_time
                print(f"[ERROR] Unexpected error: {e}")
                
                # Log the unexpected error
                log_operation_error(logger, operation, correlation_id, e,
                                  duration=duration,
                                  error_type="unexpected")
                sys.exit(1)
    
    except ConfigurationError as e:
        print(f"[ERROR] Configuration error: {e}")
        sys.exit(1)
    
    except Exception as e:
        print(f"[ERROR] Failed to initialize application: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
